# Supabase project (create free project, run supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Simple staff PIN (4–6 digits). Manager uses this on phone.
MANAGER_PIN=1234

# Public URL (used in Telegram bill links + webhook setup)
APP_URL=https://sadhrana-billing.vercel.app

# Telegram — create a dedicated bot via @BotFather (do NOT reuse the Claude channel bot)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to create bills
TELEGRAM_ALLOWED_IDS=
# Optional webhook secret (Bot API secret_token)
TELEGRAM_WEBHOOK_SECRET=
# Used by /api/telegram/setup?key=
TELEGRAM_SETUP_KEY=

# OCR for handwritten slips (any one)
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# OCR_MODEL=openai/gpt-4o-mini

# Optional branding overrides
NEXT_PUBLIC_PROPERTY_NAME=Sadhrana Bagh
NEXT_PUBLIC_PROPERTY_PHONE=+91 92209 02135
NEXT_PUBLIC_PROPERTY_EMAIL=sadhranabagh@gmail.com
NEXT_PUBLIC_PROPERTY_ADDRESS=Sadhrana Village, near Sultanpur National Park, Gurugram
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_GSTIN=

